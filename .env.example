# NTRIP caster. RTK2go needs a mountpoint reservation: http://rtk2go.com/sample-page/new-reservation/
NTRIP_SERVER=rtk2go.com
NTRIP_PORT=2101
NTRIP_PASSWORD=xxxx-not-set
NTRIP_MOUNTPOINT=xxxx-not-set

# Survey settings: accuracy to reach in meters, minimum time in seconds
GPS_ACCURACY=3.000
GPS_SURVEY_TIME=60

# Known base position as latitude:longitude:height (degrees, degrees, meters above the ellipsoid).
# Set it to skip the survey at every start, so rover positions stay repeatable. Setting a mode in the UI overrides it.
#BASE_FIXED_POSITION=

# Password for the web UI, with any user name. Without one the UI is only available on this machine.
UI_PASSWORD=

WEB_SERVER_PORT=3000
GOOGLE_MAPS_API_KEY=G_MAPS_API_KEY_NOT_SET

# Set to false on a Pi with no screen
KIOSK_BROWSER=true

# Uncomment to skip the USB search, for example with more than one F9P attached
#GPS_SERIAL_PORT=/dev/ttyACM0
