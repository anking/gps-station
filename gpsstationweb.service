# Template: install.sh fills in __USER__, __DIR__ and __NODE__ and installs the result.
[Unit]
Description=GPS Station Web Service
Wants=network-online.target
After=network-online.target
# Wait for the graphical session to start before launching the browser
After=graphical.target

[Service]
WorkingDirectory=__DIR__
ExecStart=__NODE__ build/index.js
Restart=always
RestartSec=5
User=__USER__
Environment=PATH=/usr/bin:/usr/local/bin
Environment=NODE_ENV=production
SyslogIdentifier=gps-station

[Install]
WantedBy=multi-user.target
