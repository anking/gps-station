{
  "name": "StationApp",
  "version": "3.0.0",
  "description": "RTK base station for a ZED-F9P on a Raspberry Pi",
  "main": "build/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tsc": "tsc",
    "build": "tsc && npm run copy-assets",
    "copy-assets": "node scripts/copy-assets.js",
    "start": "node ./build/index.js",
    "debug": "node ./build/index.js --debug",
    "test": "npm run build && node --test \"build/test/*.test.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "serialport": "^13.0.0",
    "socket.io": "^4.8.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.9.0"
  }
}
